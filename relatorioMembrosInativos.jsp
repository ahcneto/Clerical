<%@ page import="java.sql.*,java.util.*" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ include file="includes/auth.jsp" %>
<%@ include file="includes/escopoRelatorios.jspf" %>
<%!
private String hmi(String v){return v==null?"":v.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;").replace("'","&#39;");}
private int imi(String v,int d){try{return Integer.parseInt(v);}catch(Exception e){return d;}}
%>
<%
String perfilMi=(String)session.getAttribute("usuarioPerfil");if(!"ADM".equals(perfilMi)&&!"REP".equals(perfilMi)&&!"EXT".equals(perfilMi)){response.sendRedirect("index.jsp");return;}
boolean repMi="REP".equals(perfilMi);Integer regiaoSessaoMi=(Integer)session.getAttribute("usuarioRegiaoId"),grupoSessaoMi=(Integer)session.getAttribute("usuarioGrupoId");String escopoMi=cadEscopoRelatorios(session);boolean restringeRegiaoMi=repMi&&"REGIAO_TODOS".equals(escopoMi);
int classeMi=imi(request.getParameter("classe"),0);if(classeMi<0)classeMi=0;int regiaoMi=imi(request.getParameter("regiao"),0);int anoMi=imi(request.getParameter("ano"),0);if(anoMi<0)anoMi=0;if(repMi&&"PROPRIO".equals(escopoMi))classeMi=grupoSessaoMi==null?-1:grupoSessaoMi;else if(restringeRegiaoMi)regiaoMi=regiaoSessaoMi==null?-1:regiaoSessaoMi;else if(repMi&&"NENHUM".equals(escopoMi))classeMi=-1;
class ItemMi{int id;String regiao,paroquia,nome,data,motivo;}
LinkedHashMap<Integer,String> gruposMi=new LinkedHashMap<Integer,String>(),regioesMi=new LinkedHashMap<Integer,String>();List<Integer> anosMi=new ArrayList<Integer>();List<ItemMi> itensMi=new ArrayList<ItemMi>();String nomeRegiaoMi="",erroMi=null;
try(Connection c=cad.db.Database.getConnection()){
 try(PreparedStatement p=c.prepareStatement("SELECT IdGrupo,NomePlural FROM grupos WHERE StatusGrupo='ATIVO' AND GrupoOperacional=1 AND ModuloRelatorios=1 ORDER BY Ordem,NomePlural");ResultSet r=p.executeQuery()){while(r.next())gruposMi.put(r.getInt(1),r.getString(2));}
 try(PreparedStatement p=c.prepareStatement("SELECT DISTINCT YEAR(DataMovimentacao) FROM HistoricoMovimentacaoMembro WHERE TipoMovimentacao='INATIVACAO' ORDER BY YEAR(DataMovimentacao) DESC");ResultSet r=p.executeQuery()){while(r.next())anosMi.add(r.getInt(1));}
 try(PreparedStatement p=c.prepareStatement("SELECT DISTINCT IdRegiao,Regiao FROM paroquia WHERE IdRegiao IS NOT NULL AND Regiao IS NOT NULL AND Regiao<>'' ORDER BY Regiao");ResultSet r=p.executeQuery()){while(r.next()){int id=r.getInt(1);String nome=r.getString(2);if(!restringeRegiaoMi||id==regiaoMi)regioesMi.put(id,nome);if(id==regiaoMi)nomeRegiaoMi=nome;}}
 String sql="SELECT p.IdPessoa,p.Nome,IFNULL(pa.Regiao,'') Regiao,IFNULL(pa.Descricao,'') Paroquia,DATE_FORMAT(h.DataMovimentacao,'%d/%m/%Y') DataDesligamento,IFNULL(h.Motivo,'') Motivo,YEAR(h.DataMovimentacao) Ano FROM pessoas p JOIN paroquia pa ON pa.IdParoquia=p.IdParoquia JOIN HistoricoMovimentacaoMembro h ON h.IdPessoa=p.IdPessoa AND h.TipoMovimentacao='INATIVACAO' AND h.IdMovimentacao=(SELECT MAX(h2.IdMovimentacao) FROM HistoricoMovimentacaoMembro h2 WHERE h2.IdPessoa=p.IdPessoa AND h2.TipoMovimentacao='INATIVACAO') WHERE p.Status=0 AND (?=0 OR h.ClasseAnterior=?) AND (?=0 OR pa.IdRegiao=?) AND (?=0 OR YEAR(h.DataMovimentacao)=?) ORDER BY h.DataMovimentacao DESC,p.Nome";
 try(PreparedStatement p=c.prepareStatement(sql)){p.setInt(1,classeMi);p.setInt(2,classeMi);p.setInt(3,regiaoMi);p.setInt(4,regiaoMi);p.setInt(5,anoMi);p.setInt(6,anoMi);try(ResultSet r=p.executeQuery()){while(r.next()){ItemMi i=new ItemMi();i.id=r.getInt("IdPessoa");i.nome=r.getString("Nome");i.regiao=r.getString("Regiao");i.paroquia=r.getString("Paroquia");i.data=r.getString("DataDesligamento");i.motivo=r.getString("Motivo");itensMi.add(i);}}}
}catch(Exception e){e.printStackTrace();erroMi="Não foi possível carregar o relatório de membros inativos.";}
String nomeGrupoMi=classeMi==0?"Todos os grupos":gruposMi.get(classeMi);if(nomeGrupoMi==null)nomeGrupoMi="Grupo";
%>
<!DOCTYPE html><html lang="pt-br"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Membros inativos</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet"><link rel="stylesheet" href="css/style.css"><style>.mi-filter{background:#fff;border:1px solid #e8edf3;border-radius:16px;padding:20px}.mi-photo{width:42px;height:42px;object-fit:cover;border-radius:50%;background:#f1f5f9}.mi-table th{font-size:11px;text-transform:uppercase;color:#64748b}.mi-photo{cursor:zoom-in}.mi-photo-modal[hidden]{display:none}.mi-photo-modal{position:fixed;inset:0;z-index:2000;background:rgba(15,23,42,.82);display:flex;align-items:center;justify-content:center;padding:48px}.mi-photo-modal img{max-width:min(90vw,900px);max-height:85vh;object-fit:contain;border-radius:12px;box-shadow:0 16px 50px #0008}.mi-photo-close{position:absolute;top:16px;right:24px;border:0;background:transparent;color:#fff;font-size:42px;line-height:1;cursor:pointer}@media print{@page{size:A4 landscape;margin:10mm}.navbar,footer,.no-print{display:none!important}body{background:#fff!important}.container{max-width:none!important;padding:0!important}.profile-card{box-shadow:none!important}.mi-photo{width:32px;height:32px}.mi-table tr{break-inside:avoid;page-break-inside:avoid}.mi-table thead{display:table-header-group}.mi-table tfoot{display:table-footer-group}.mi-table td,.mi-table th{break-inside:avoid;page-break-inside:avoid}}</style></head><body><jsp:include page="includes/header.jsp"/><main class="container py-4">
<div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4"><div><a href="relatorios.jsp" class="btn btn-link px-0 no-print"><i class="bi bi-arrow-left"></i> Voltar aos relatórios</a><h1 class="fw-bold mb-1">Membros inativos</h1><p class="text-muted mb-0"><%=hmi(nomeGrupoMi)%><%=regiaoMi!=0?" · "+hmi(nomeRegiaoMi):""%></p></div><button class="btn btn-outline-secondary no-print" onclick="window.print()"><i class="bi bi-printer"></i> Imprimir</button></div>
<form method="get" class="mi-filter mb-4 no-print"><div class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label">Grupo</label><select name="classe" class="form-select" <%=repMi?"disabled":""%>><option value="0" <%=classeMi==0?"selected":""%>>Todos os grupos</option><%for(Map.Entry<Integer,String>x:gruposMi.entrySet()){%><option value="<%=x.getKey()%>" <%=x.getKey()==classeMi?"selected":""%>><%=hmi(x.getValue())%></option><%}%></select><%if(repMi){%><input type="hidden" name="classe" value="<%=classeMi%>"><%}%></div><div class="col-md-3"><label class="form-label">Região episcopal</label><%if(repMi){%><input class="form-control" value="<%=hmi(nomeRegiaoMi.isEmpty()?"Região não identificada":nomeRegiaoMi)%>" disabled><%}else{%><select name="regiao" class="form-select"><option value="0">Todas as regiões</option><%for(Map.Entry<Integer,String>x:regioesMi.entrySet()){%><option value="<%=x.getKey()%>" <%=x.getKey()==regiaoMi?"selected":""%>><%=hmi(x.getValue())%></option><%}%></select><%}%></div><div class="col-md-3"><label class="form-label">Ano do desligamento</label><select name="ano" class="form-select"><option value="0">Todos os anos</option><%for(Integer ano:anosMi){%><option value="<%=ano%>" <%=ano==anoMi?"selected":""%>><%=ano%></option><%}%></select></div><div class="col-md-3"><button class="btn btn-orange w-100"><i class="bi bi-funnel"></i> Aplicar filtros</button></div></div></form>
<%if(erroMi!=null){%><div class="alert alert-danger"><%=hmi(erroMi)%></div><%}%><div class="d-flex justify-content-between align-items-center mb-3"><h4 class="mb-0">Desligamentos</h4><span class="text-muted"><%=itensMi.size()%> registro(s)</span></div><section class="profile-card"><div class="table-responsive"><table class="table table-hover align-middle mi-table mb-0"><thead><tr><th>Foto</th><th>Nome</th><th>Paróquia</th><th>Região</th><th>Data do desligamento</th><th>Motivo do desligamento</th></tr></thead><tbody><%if(itensMi.isEmpty()){%><tr><td colspan="6" class="text-center text-muted py-5">Nenhum membro inativo encontrado para os filtros selecionados.</td></tr><%}else{for(ItemMi i:itensMi){%><tr><td><img class="mi-photo" src="fotos/foto_<%=i.id%>.jpg" alt="Foto de <%=hmi(i.nome)%>" role="button" tabindex="0" title="Clique para ampliar" onclick="abrirFotoMi(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();abrirFotoMi(this)}" onerror="this.style.visibility='hidden'"></td><td><strong><%=hmi(i.nome)%></strong></td><td><%=hmi(i.paroquia.isEmpty()?"—":i.paroquia)%></td><td><%=hmi(i.regiao.isEmpty()?"—":i.regiao)%></td><td class="text-nowrap"><%=hmi(i.data==null?"—":i.data)%></td><td style="min-width:260px;white-space:pre-line"><%=hmi(i.motivo.isEmpty()?"—":i.motivo)%></td></tr><%}}%></tbody></table></div></section></main><div id="miPhotoModal" class="mi-photo-modal no-print" role="dialog" aria-modal="true" aria-label="Foto ampliada" hidden onclick="if(event.target===this)fecharFotoMi()"><button type="button" class="mi-photo-close" aria-label="Fechar" onclick="fecharFotoMi()">&times;</button><img id="miPhotoLarge" src="" alt="Foto ampliada"></div><jsp:include page="includes/footer.jsp"/><script>function abrirFotoMi(img){var modal=document.getElementById("miPhotoModal"),grande=document.getElementById("miPhotoLarge");grande.src=img.src;grande.alt=img.alt;modal.hidden=false;document.body.style.overflow="hidden";modal.querySelector("button").focus()}function fecharFotoMi(){document.getElementById("miPhotoModal").hidden=true;document.body.style.overflow=""}document.addEventListener("keydown",function(e){if(e.key==="Escape")fecharFotoMi()})</script></body></html>