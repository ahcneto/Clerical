<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="includes/auth.jsp" %><%
String perfilAcomp=(String)session.getAttribute("usuarioPerfil");if(!"ADM".equals(perfilAcomp)&&!"EXT".equals(perfilAcomp)){response.sendRedirect("documentacoes.jsp");return;}boolean podeEditarAcomp="ADM".equals(perfilAcomp);
%><!DOCTYPE html><html lang="pt-br"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Acompanhamento de documentos</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet"><link rel="stylesheet" href="css/style.css"><style>.doc-member-photo{width:42px;height:42px;border-radius:50%;object-fit:cover;background:#eef2f6}.doc-filter-card{background:#fff;border:1px solid #e5eaf0;border-radius:16px;padding:18px}.doc-check{white-space:nowrap}@media print{@page{size:landscape;margin:10mm}.navbar,footer,.no-print,.doc-check,.doc-member-photo{display:none!important}body{background:#fff!important}.container{max-width:none!important;padding:0!important}.profile-card{border:0!important;box-shadow:none!important;padding:0!important}.table{font-size:10pt}.badge{border:1px solid #adb5bd;color:#212529!important;background:#fff!important}}</style></head><body><jsp:include page="includes/header.jsp"/>
<main class="container py-4"><div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4"><div><a href="documentacoes.jsp" class="btn btn-link px-0 no-print"><i class="bi bi-arrow-left"></i> Voltar aos checklists</a><h1 id="acompTitulo" class="fw-bold mb-1">Acompanhamento</h1><p id="acompSubtitulo" class="text-muted mb-0">Carregando checklist...</p></div><div class="d-flex gap-2 no-print"><a class="btn btn-outline-primary" href="relatorioDocumentacoes.jsp?checklist=<%= request.getParameter("id")!=null&&request.getParameter("id").matches("\\d+")?request.getParameter("id"):"0" %>"><i class="bi bi-ui-checks-grid"></i> Relatório matricial</a><button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Imprimir lista</button></div></div>
<div class="row g-3 mb-4 no-print"><div class="col-md-4"><div class="dashboard-card"><h5>Registros</h5><div id="acompTotal" class="card-number">—</div></div></div><div class="col-md-4"><div class="dashboard-card"><h5>Entregues</h5><div id="acompConcluidos" class="card-number text-success">—</div></div></div><div class="col-md-4"><div class="dashboard-card"><h5>Pendentes</h5><div id="acompPendentes" class="card-number text-warning">—</div></div></div></div>
<div class="doc-filter-card mb-4 no-print"><div class="row g-3"><div class="col-md-4"><label class="form-label">Pesquisar membro</label><input id="acompFiltroNome" type="search" class="form-control" placeholder="Digite o nome..."></div><div class="col-md-2"><label class="form-label">Região</label><select id="acompFiltroRegiao" class="form-select"><option value="">Todas</option></select></div><div class="col-md-2"><label class="form-label">Turma</label><select id="acompFiltroTurma" class="form-select"><option value="">Todas</option></select></div><div class="col-md-2"><label class="form-label">Documento</label><select id="acompFiltroItem" class="form-select"><option value="">Todos</option></select></div><div class="col-md-2"><label class="form-label">Situação</label><select id="acompFiltroStatus" class="form-select"><option value="">Todos</option><option value="PENDENTE">Pendentes</option><option value="CONCLUIDO">Entregues</option></select></div></div></div>
<section class="profile-card"><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Região</th><th>Paróquia - Bairro</th><th>Nome</th><th>Turma</th><th>Documento</th><th>Situação</th><% if(podeEditarAcomp){ %><th class="doc-check">Ação</th><% } %></tr></thead><tbody id="acompBody"><tr><td colspan="7" class="text-muted">Carregando...</td></tr></tbody></table></div></section></main>
<jsp:include page="includes/footer.jsp"/><script>window.checklistAcompanhamentoId=Number(new URLSearchParams(location.search).get("id")||0);window.podeEditarDocumentacao=<%= podeEditarAcomp %>;</script><script src="js/documentacao-acompanhamento.js?v=20260824-2"></script></body></html>
