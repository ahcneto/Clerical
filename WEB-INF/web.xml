<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                      http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
  version="4.0"
  metadata-complete="true">

    <!-- Servlet seguro de foto compilado para o Java do servidor. -->
    <description>
      Servlet and JSP Examples.
    </description>
    <display-name>Servlet and JSP Examples</display-name>

	<session-config>
		<session-timeout>30</session-timeout>
	</session-config>

    <resource-ref>
        <description>Pool central de conexoes do CAD</description>
        <res-ref-name>jdbc/CadDB</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>

    <request-character-encoding>UTF-8</request-character-encoding>

    <servlet>
        <servlet-name>XSQLServlet</servlet-name>
        <servlet-class>oracle.xml.xsql.XSQLServlet</servlet-class>
    </servlet>

    <servlet>
        <servlet-name>UploadFotoServlet</servlet-name>
        <servlet-class>UploadFotoServlet</servlet-class>
        <multipart-config>
            <max-file-size>5242880</max-file-size>
            <max-request-size>6291456</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>

    <servlet>
        <servlet-name>DocumentoMembroServlet</servlet-name>
        <servlet-class>DocumentoMembroServlet</servlet-class>
        <load-on-startup>2</load-on-startup>
        <multipart-config>
            <max-file-size>3145728</max-file-size>
            <max-request-size>3407872</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>

    <!-- Mapeamentos -->
    <servlet-mapping>
        <servlet-name>XSQLServlet</servlet-name>
        <url-pattern>*.xsql</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>UploadFotoServlet</servlet-name>
        <url-pattern>/UploadFotoServlet</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>DocumentoMembroServlet</servlet-name>
        <url-pattern>/DocumentoMembroServlet</url-pattern>
    </servlet-mapping>


    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
