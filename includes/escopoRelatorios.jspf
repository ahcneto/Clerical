<%@ page import="java.sql.*" %>
<%!
private String cadEscopoRelatorios(javax.servlet.http.HttpSession sessao) throws SQLException {
    if (!"REP".equals((String)sessao.getAttribute("usuarioPerfil"))) return "TODOS";
    Integer grupo=(Integer)sessao.getAttribute("usuarioGrupoId");
    if(grupo==null)return "NENHUM";
    try(Connection c=cad.db.Database.getConnection();PreparedStatement p=c.prepareStatement("SELECT EscopoRepRelatorios FROM grupos WHERE IdGrupo=?")){
        p.setInt(1,grupo);try(ResultSet r=p.executeQuery()){return r.next()&&r.getString(1)!=null?r.getString(1):"NENHUM";}
    }
}
%>
