 int conta=0;try(PreparedStatement p=c.prepareStatement("SELECT IdConta FROM financeiro_contas WHERE Codigo='1.01'" );ResultSet r=p.executeQuery()){if(r.next())conta=r.getInt(1);}if(conta==0)return;
