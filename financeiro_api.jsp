 try(PreparedStatement p=c.prepareStatement(q);ResultSet r=p.executeQuery();PreparedStatement u=c.prepareStatement("INSERT INTO financeiro_lancamentos(IdGrupo,IdConta,Tipo,Descricao,Competencia,DtRealizada,Valor,Situacao,Origem,Referencia,IdUsuarioCriacao)VALUES(?,?,'ENTRADA',?,? ,LAST_DAY(?),?,'REALIZADO','CONTRIBUICOES',?,?) ON DUPLICATE KEY UPDATE Descricao=VALUES(Descricao),Valor=VALUES(Valor),DtRealizada=VALUES(DtRealizada),Situacao='REALIZADO',IdUsuarioAtualizacao=VALUES(IdUsuarioCriacao),DtAtualizacao=NOW()")){while(r.next()){Date comp=Date.valueOf(String.format("%04d-%02d-01",r.getInt("ano"),r.getInt("mes")));String ref="CONTRIB:"+r.getInt("idClasse")+":"+String.format("%04d-%02d",r.getInt("ano"),r.getInt("mes"));u.setInt(1,r.getInt("idClasse"));u.setInt(2,conta);u.setString(3,"Contribuições mensais — "+String.format("%02d/%04d",r.getInt("mes"),r.getInt("ano"))+" ("+r.getInt("qtd")+" pagamentos)");u.setDate(4,comp);u.setDate(5,comp);u.setBigDecimal(6,r.getBigDecimal("total"));u.setString(7,ref);u.setInt(8,usuario);u.addBatch();}u.executeBatch();}
}
