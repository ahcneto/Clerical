  s.executeUpdate("CREATE TABLE IF NOT EXISTS financeiro_lancamentos_log(IdLog BIGINT AUTO_INCREMENT PRIMARY KEY,IdLancamento INT NULL,Acao VARCHAR(20) NOT NULL,IdUsuario INT NOT NULL,DtLog TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,DadosAnteriores TEXT NULL,DadosNovos TEXT NULL,Motivo VARCHAR(500) NULL)");
  s.executeUpdate("INSERT IGNORE INTO financeiro_contas(Codigo,Nome,Tipo) VALUES('1.01','Contribuições','ENTRADA'),('1.02','Doações','ENTRADA'),('1.03','Eventos','ENTRADA'),('2.01','Alimentação','SAIDA'),('2.02','Transporte','SAIDA'),('2.03','Material','SAIDA'),('2.04','Outras despesas','SAIDA')");
 }
}
void logf(Connection c,int id,String acao,int usuario,String antes,String depois,String motivo)throws SQLException{if("EDICAO".equals(acao)&&(antes==null||antes.isEmpty()))acao="CRIACAO";try(PreparedStatement p=c.prepareStatement("INSERT INTO financeiro_lancamentos_log(IdLancamento,Acao,IdUsuario,DadosAnteriores,DadosNovos,Motivo)VALUES(?,?,?,?,?,?)")){if(id==0)p.setNull(1,Types.INTEGER);else p.setInt(1,id);p.setString(2,acao);p.setInt(3,usuario);p.setString(4,antes);p.setString(5,depois);p.setString(6,motivo);p.executeUpdate();}}
String estado(Connection c,int id)throws SQLException{try(PreparedStatement p=c.prepareStatement("SELECT CONCAT('grupo=',IdGrupo,';conta=',IdConta,';tipo=',Tipo,';valor=',Valor,';situacao=',Situacao,';competencia=',Competencia,';descricao=',Descricao) FROM financeiro_lancamentos WHERE IdLancamento=?")){p.setInt(1,id);try(ResultSet r=p.executeQuery()){return r.next()?r.getString(1):"";}}}
