private String jmc(String s){return s==null?"":s.replace("\\","\\\\").replace("\"","\\\"").replace("\r","\\r").replace("\n","\\n");}
private int imc(String s,int d){try{return Integer.parseInt(s);}catch(Exception e){return d;}}
private boolean podeVerPessoa(Connection c,String perfil,Integer usuario,Integer grupo,Integer regiao,int pessoa)throws SQLException{
 if(usuario==null)return false;if(usuario==pessoa||"ADM".equals(perfil)||"EXT".equals(perfil))return true;if(!"REP".equals(perfil)||grupo==null)return false;
 try(PreparedStatement p=c.prepareStatement("SELECT p.Classe,IFNULL(pa.IdRegiao,0),g.EscopoRepMembros FROM pessoas p LEFT JOIN paroquia pa ON pa.IdParoquia=p.IdParoquia JOIN grupos g ON g.IdGrupo=? WHERE p.IdPessoa=?")){p.setInt(1,grupo);p.setInt(2,pessoa);try(ResultSet r=p.executeQuery()){if(!r.next())return false;String e=r.getString(3);return "TODOS".equals(e)||("PROPRIO".equals(e)&&r.getInt(1)==grupo)||("REGIAO_TODOS".equals(e)&&regiao!=null&&r.getInt(2)==regiao);}}
}
%><%
String perfil=(String)session.getAttribute("usuarioPerfil"),acao=request.getParameter("acao");Integer usuario=(Integer)session.getAttribute("usuarioId"),grupo=(Integer)session.getAttribute("usuarioGrupoId"),regiao=(Integer)session.getAttribute("usuarioRegiaoId");
if(usuario==null){response.setStatus(401);out.print("{\"ok\":false,\"mensagem\":\"Sessão inválida.\"}");return;}response.setHeader("Cache-Control","no-store");
