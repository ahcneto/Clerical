<%@ page contentType="text/html;charset=UTF-8" %><%@ include file="includes/auth.jsp" %><%@ include file="includes/access.jsp" %><% String pf=(String)session.getAttribute("usuarioPerfil");Integer gf=(Integer)session.getAttribute("usuarioGrupoId");boolean admf="ADM".equals(pf); %>
<!doctype html><html lang="pt-br"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Controle financeiro</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet"><link rel="stylesheet" href="css/style.css"><link rel="stylesheet" href="css/financeiro.css"></head><body><jsp:include page="includes/header.jsp"/><main class="container py-4">
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4"><div><h1 class="fw-bold">Controle financeiro</h1><p class="text-muted">Entradas, saídas e previsões por grupo</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="relatorioFinanceiro.jsp"><i class="bi bi-file-earmark-bar-graph"></i> Relatório</a><%if(admf){%><button class="btn btn-outline-secondary" onclick="abrirPlano()"><i class="bi bi-diagram-3"></i> Plano de contas</button><%}%><button class="btn btn-orange" onclick="abrirLancamento()"><i class="bi bi-plus-lg"></i> Novo lançamento</button></div></div>
<section class="profile-card mb-4"><div class="row g-3"><div class="col-md-2"><label class="form-label">Mês</label><select id="finMes" class="form-select"></select></div><div class="col-md-2"><label class="form-label">Ano</label><select id="finAno" class="form-select"></select></div><%if(admf){%><div class="col-md-4"><label class="form-label">Grupo</label><select id="finGrupo" class="form-select"><option value="-1">Consolidado — todos os grupos</option></select></div><%}else{%><input id="finGrupo" type="hidden" value="<%=gf%>"><%}%><div class="col-md-2"><label class="form-label">Situação</label><select id="finSituacao" class="form-select"><option value="">Todas</option><option>PREVISTO</option><option>REALIZADO</option><option>CANCELADO</option></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-secondary w-100" onclick="carregarFinanceiro()">Aplicar</button></div></div></section>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="dashboard-card"><h5>Entradas realizadas</h5><div id="finEntradas" class="card-number text-success">R$ 0,00</div></div></div><div class="col-md-4"><div class="dashboard-card"><h5>Saídas realizadas</h5><div id="finSaidas" class="card-number text-danger">R$ 0,00</div></div></div><div class="col-md-4"><div class="dashboard-card"><h5>Saldo realizado</h5><div id="finSaldo" class="card-number">R$ 0,00</div></div></div></div>
<section class="profile-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Competência</th><th>Grupo</th><th>Conta</th><th>Descrição</th><th>Situação</th><th class="text-end">Valor</th><th></th></tr></thead><tbody id="finLinhas"></tbody></table></div></section></main>
<div class="modal fade" id="finModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Novo lançamento previsto</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input id="lanId" type="hidden"><div class="row g-3"><div class="col-md-4"><label class="form-label">Tipo</label><select id="lanTipo" class="form-select"><option value="ENTRADA">Entrada</option><option value="SAIDA">Saída</option></select></div><div class="col-md-4"><label class="form-label">Grupo</label><select id="lanGrupo" class="form-select"></select></div><div class="col-md-4"><label class="form-label">Plano de contas</label><select id="lanConta" class="form-select"></select></div><div class="col-md-4"><label class="form-label">Competência</label><input id="lanCompetencia" type="month" class="form-control"></div><div class="col-md-4"><label class="form-label">Data prevista</label><input id="lanPrevista" type="date" class="form-control"></div><div class="col-md-4"><label class="form-label">Valor</label><input id="lanValor" type="number" min="0.01" step="0.01" class="form-control"></div><div class="col-12"><label class="form-label">Descrição</label><input id="lanDescricao" class="form-control" maxlength="255"></div></div></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-orange" onclick="salvarLancamento()">Salvar</button></div></div></div></div>
<div class="modal fade" id="planoModal" tabindex="-1"><div class="modal-dialog modal-xl"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Plano de contas</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3 mb-4"><input id="contaId" type="hidden"><div class="col-md-2"><label class="form-label">Código</label><input id="contaCodigo" class="form-control" placeholder="1.04"></div><div class="col-md-4"><label class="form-label">Nome</label><input id="contaNome" class="form-control"></div><div class="col-md-2"><label class="form-label">Tipo</label><select id="contaTipo" class="form-select"><option value="ENTRADA">Entrada</option><option value="SAIDA">Saída</option></select></div><div class="col-md-2"><label class="form-label">Status</label><select id="contaStatus" class="form-select"><option value="ATIVA">Ativa</option><option value="INATIVA">Inativa</option></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-orange w-100" onclick="salvarConta()">Salvar conta</button></div></div><table class="table"><thead><tr><th>Código</th><th>Conta</th><th>Tipo</th><th>Status</th><th></th></tr></thead><tbody id="planoLinhas"></tbody></table></div></div></div></div>
<div class="modal fade" id="detalheFinModal" tabindex="-1"><div class="modal-dialog modal-xl"><div class="modal-content"><div class="modal-header"><h5 id="detalheFinTitulo" class="modal-title"></h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div id="detalheFinCorpo" class="modal-body"></div></div></div></div>
<jsp:include page="includes/footer.jsp"/><script>window.finAdm=<%=admf%>;window.finGrupoSessao=<%=gf%>;</script><script src="js/financeiro.js?v=20260821-2"></script></body></html>
